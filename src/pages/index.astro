---
import Base from '../layouts/Base.astro';
import { DEMO, SIGNUP } from '../consts';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);

const pains = [
  ['같은 피드백을 매번 반복합니다', '“결론부터요” “숫자 기준일은요?” 결과물마다 같은 말을 하고, 기준은 금세 다시 흐려집니다.', '팀장님 기준으로 먼저 피드백하고, 반복해서 맞춰 줍니다'],
  ['일이 너무 많아 팀원까지 챙길 여력이 없습니다', '보고 · 회의 · 결재에 치이다 보면 1on1은 밀리고, 칭찬할 타이밍은 지나가고, 지친 팀원은 말이 없습니다.', '이번 주 팀원별로 해야 할 액션을 골라 바로 할 수 있게 준비해 둡니다'],
  ['결정할 일이 쌓여 팀이 멈춥니다', '메신저 · 회의 · 위에서 온 지시 속에 흩어진 “결정해 주세요”를 다 챙기기 어렵습니다.', '빨리 결정해야 할 것부터 선택지와 근거까지 정리합니다'],
  ['문제는 터지고 나서야 압니다', '밀리는 과제, 꺾이는 컨디션은 보고가 올라올 때쯤이면 이미 늦습니다.', '기록에서 위험 신호를 먼저 찾아 미리 알려 줍니다'],
];
const plans = [
  { name: 'Starter', price: '29,000', members: '팀원 4명까지', points: ['목표 · 성과입력 · 1on1', 'AI 조기 경고 · 분기 전망', '팀원 업무플랫폼 · Sim.Box'] },
  { name: 'Pro', price: '49,000', members: '팀원 10명까지', points: ['Starter의 모든 기능', '평가 초안 · 과제 히스토리', '컨설팅 노하우 카드'], best: true },
  { name: 'Pro+', price: '79,000', members: '팀원 20명까지', points: ['Pro의 모든 기능', '큰 팀을 위한 넉넉한 AI 사용량'] },
];
const faqs = [
  ['팀원도 요금을 내야 하나요?', '아니요. 팀장 한 명만 구독하고, 팀원은 무료로 초대합니다. 팀원은 성과입력 · 1on1 · 팀 방향 · Sim.Box를 그대로 씁니다.'],
  ['체험 기간에는 어떤 기능을 쓸 수 있나요?', '14일 동안 가장 큰 요금제(Pro+)의 모든 기능을 씁니다. 체험이 끝나도 쌓인 기록은 지우지 않고, 요금제를 고르면 그대로 이어집니다.'],
  ['팀원이 쓴 내용을 팀장이 다 볼 수 있나요?', '업무 기록은 팀장과 함께 보지만, 팀원 혼자 쓰는 Sim.Box는 팀장을 포함해 누구도 읽을 수 없습니다. 팀장에게는 이름 없는 팀 전체 경향만 보입니다.'],
  ['AI가 엉뚱한 말을 지어내지는 않나요?', 'ATEAM의 분석은 팀이 실제로 남긴 목표 · 업무 · 1on1 · 결과물 기록에 근거합니다. 기록이 부족하면 부족하다고 말하고, 근거가 된 기록을 함께 보여 줍니다.'],
  ['어떤 팀에 맞나요?', '팀원 3~20명 규모로 목표와 결과물을 다루는 팀이면 직무와 상관없이 쓸 수 있습니다. 마케팅 · 기획 · 영업 · 개발 · 경영지원 팀장이 주로 씁니다.'],
];
// 이렇게 사용하세요 — 실제 화면(데모 팀 데이터로 캡처: public/shots)
const I = {
  dash: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  goal: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  work: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  people: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  split: '<path d="M16 3h5v5M8 3H3v5M12 22v-8.3a4 4 0 0 0-1.17-2.83L3 3M21 3l-7.83 7.83"/>',
  history: '<path d="M16 22h2a2 2 0 0 0 2-2V8l-5-5H6a2 2 0 0 0-2 2v3"/><circle cx="8" cy="16" r="6"/><path d="M9.5 17.5 8 16.25V14"/>',
  exec: '<circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/><path d="m12 11 1.2 2.4-1.2 5-1.2-5z"/>',
  eval: '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
};
const uses = [
  { k: 'dash', t: '대시보드 · 데일리 브리핑', img: 'home', b: ['매일 아침 ATEAM이 팀 기록을 읽고 오늘 챙길 것만 골라 정리합니다.', '팀 성과 · 의사결정 · 리스크 · 업무플랫폼 · 팀원관리 · 조직 소식을 한 화면에서 봅니다.', '숫자마다 근거가 된 기록으로 바로 들어갈 수 있습니다.'] },
  { k: 'goal', t: '팀목표 · 성과입력', img: 'goals', b: ['목표 → 과제 → 할 일을 한 트리로 세우고, 담당자 · 일정 · 진척을 타임라인으로 봅니다.', '팀원이 성과입력으로 올린 진척은 승인하면 목표에 바로 반영됩니다.', '목표별 달성 가능성과 마감 전망을 AI가 매주 다시 계산합니다.'] },
  { k: 'work', t: '업무플랫폼', img: 'work', b: ['팀원별 · 그룹별 스페이스에서 결과물 · 의견 요청 · 보고를 주고받습니다.', 'ATEAM이 먼저 읽고, 팀장이 꼭 봐야 할 것부터 골라 올려 줍니다.', '파일을 올리면 버전이 쌓이고, 과제 태그로 과제별 흐름이 정리됩니다.'] },
  { k: 'people', t: '팀원관리', img: 'person', b: ['컨디션 · 이탈 가능성 · 업무 부하 · 활동 · 1on1 공백을 신호등으로 한눈에 봅니다.', '이번 주 누구에게 1on1 · 칭찬 · 독려 · 지원이 필요한지 AI가 추천합니다.', '활동 · 부하 흐름으로 과부하와 의욕 저하를 일찍 알아챕니다.'] },
  { k: 'split', t: '의사결정', img: 'decide', b: ['목표 · 팀 대화 · 위에서 온 지시에서 결정이 필요한 것을 찾아 선택지와 근거까지 정리합니다.', '팀원이 대화 중에 "결정해 주세요"라고 한 요청도 자동으로 모입니다.', '미뤄 둔 결정이 무엇을 막고 있는지 함께 보여 줍니다.'] },
  { k: 'history', t: '히스토리 관리', img: 'history', b: ['해마다 이름이 바뀌는 과제를 AI가 하나의 핵심 업무로 묶어 수년간의 흐름을 정리합니다.', '지켜 온 원칙 · 오래 이어진 관계자 · 해 봤는데 안 된 것까지 자동으로 쌓입니다.', '담당자가 바뀌면 버튼 하나로 인수인계 자료를 보냅니다.'] },
  { k: 'exec', t: '임원 브리핑', img: 'upward', b: ['상위 관리자별 이번 주 관심사와 예상 질문, 준비할 답을 미리 정리합니다.', '위에서 온 요청 중 아직 답하지 않은 것을 놓치지 않게 챙깁니다.', '먼저 알리면 좋을 소식까지 골라 보고 타이밍을 잡아 줍니다.'] },
  { k: 'eval', t: '평가 시뮬레이션', img: 'eval', b: ['한 해 동안 쌓인 성과 · 1on1 · 결과물을 근거로 팀원별 평가 초안을 만듭니다.', '등급 시뮬레이션과 함께 근거가 부족한 부분은 부족하다고 표시합니다.', '평가 면담에서 꺼낼 강점 · 보완점을 기록으로 뒷받침합니다.'] },
];
const memberShots = [
  { img: 'm_goals', t: '팀목표 · 성과입력', d: '팀 목표와 내 과제를 한눈에 보고, 성과를 바로 입력합니다. 팀장님이 승인하면 팀목표에 그대로 반영됩니다.' },
  { img: 'm_dir', t: '팀의 기준 · 일 잘하는 방식', d: '팀장님이 반복해서 강조한 기준을 ATEAM이 정리해 두고 계속 리마인드합니다. 같은 말을 열 번 듣지 않아도 됩니다.' },
  { img: 'm_board', t: '매니징 보드', d: '팀장님 지침 · 받은 피드백 · 칭찬 · 1on1을 한곳에 모아 봅니다.' },
  { img: 'm_hist', t: '히스토리 한 번에 받기', d: '맡게 된 업무의 수년간 흐름 · 원칙 · 관계자 · 조심할 점을 한 번에 받아 빠르게 파악합니다.' },
];
---
<Base dark>
  <!-- 히어로: 큰 제목 두 장이 번갈아 넘어간다 (가운데 정렬) -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div aria-hidden class="absolute left-1/2 -translate-x-1/2 -top-56 w-[900px] h-[620px] rounded-full bg-indigo-600/30 blur-[140px]"></div>
    <div class="relative max-w-5xl mx-auto px-5 pt-20 pb-14 md:pt-28 md:pb-16 text-center flex flex-col items-center">
      <p class="text-base md:text-xl font-semibold tracking-wide text-indigo-300">팀장님을 위한 개인용 AI Solution</p>
      <div class="hero-slides mt-6 grid w-full" data-hero>
        <h1 class="hero-slide is-on text-[40px] sm:text-[56px] md:text-[76px] leading-[1.15] font-black tracking-tight">팀 운영을 위한 슈퍼에이전트<br /><span class="text-indigo-300">ATEAM</span></h1>
        <h1 class="hero-slide text-[40px] sm:text-[56px] md:text-[76px] leading-[1.15] font-black tracking-tight" aria-hidden="true">자율주행 엔진이<br /><span class="text-indigo-300">S급 팀</span>을 만들어줍니다</h1>
        <h1 class="hero-slide text-[40px] sm:text-[56px] md:text-[76px] leading-[1.15] font-black tracking-tight" aria-hidden="true">팀 운영,<br />더 이상<br class="sm:hidden" /> <span class="text-indigo-300 whitespace-nowrap">혼자가 아닙니다</span></h1>
      </div>
      <div class="mt-7 flex items-center gap-2" role="tablist" aria-label="제목 넘기기">
        <button type="button" data-dot="0" class="hero-dot is-on" aria-label="첫 번째 제목"></button>
        <button type="button" data-dot="1" class="hero-dot" aria-label="두 번째 제목"></button>
        <button type="button" data-dot="2" class="hero-dot" aria-label="세 번째 제목"></button>
      </div>
      <p class="mt-8 text-base sm:text-lg md:text-xl text-slate-300 leading-relaxed max-w-3xl">마스터 컨설턴트가 20년간 쌓은<br class="sm:hidden" /> 팀 운영 노하우를 집대성했습니다.<br />놓친 것은 챙기고,<br class="sm:hidden" /> 보이지 않던 데이터에서 예리한 인사이트까지.<br /><b class="inline-block mt-2 text-white font-bold">이제 슈퍼 파트너와 함께하세요.</b></p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={SIGNUP} class="inline-flex items-center rounded-xl bg-indigo-500 hover:bg-indigo-400 px-7 py-4 text-base md:text-lg font-bold">14일 무료로 시작하기 →</a>
        <a href={DEMO} class="inline-flex items-center rounded-xl px-6 py-4 text-base md:text-lg font-semibold text-slate-200 ring-1 ring-white/15 hover:bg-white/5">데모 신청하기</a>
      </div>
      <p class="mt-5 text-sm text-slate-500">팀장 1명 구독 · 팀원은 무료 초대</p>
    </div>
    <!-- ATEAM 에이전트 (일러스트) — 가운데 팀장님, 그 곁을 ATEAM 에이전트가 감싸고 여섯 방면을 돌보며 말을 건넨다 (자비스처럼) -->
    <div class="relative max-w-6xl mx-auto px-5 pb-20 md:pb-28">
      <div class="jv relative rounded-[28px] overflow-hidden ring-1 ring-white/10 bg-[#070918] px-5 py-8 md:px-10 md:py-12 shadow-[0_40px_140px_-40px_rgba(99,102,241,.75)]" data-jv>
        <div aria-hidden="true" class="absolute inset-0 jv-grid"></div>
        <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] items-center">
          <!-- HUD -->
          <div class="relative mx-auto w-full max-w-[520px] aspect-square">
            <div aria-hidden="true" class="absolute inset-[6%] rounded-full bg-indigo-600/20 blur-3xl"></div>
            <svg viewBox="0 0 600 600" class="relative w-full h-full" role="img" aria-label="가운데 팀장님을 ATEAM 에이전트가 감싸고, 업무 피드백 · 팀원 케어 · 의사결정 · 리스크 경고 · 임원 보고 · 히스토리 여섯 방면을 돌봅니다">
              <defs>
                <radialGradient id="jvMe" cx="50%" cy="38%" r="70%"><stop offset="0" stop-color="#2a2f6e"/><stop offset="1" stop-color="#0d1030"/></radialGradient>
                <linearGradient id="jvRing" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#a5b4fc"/><stop offset=".5" stop-color="#818cf8"/><stop offset="1" stop-color="#c084fc"/></linearGradient>
                <linearGradient id="jvSweep" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="rgba(129,140,248,0)"/><stop offset="1" stop-color="rgba(129,140,248,.35)"/></linearGradient>
                <path id="jvText" d="M300 300 m-168 0 a168 168 0 1 1 336 0 a168 168 0 1 1 -336 0"/>

  <style>
    .use-shot { background: radial-gradient(120% 120% at 0% 0%, #312e81 0%, #4338ca 38%, #7c3aed 72%, #a78bfa 100%); }
    .use-img { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
    .use-img.is-on { opacity: 1; transform: none; }
    .use { position: relative; }
    .use-t { color: #94a3b8; transition: color .2s; }
    .use-ic { color: #94a3b8; }
    .use.is-on .use-t { color: #0f172a; }
    .use.is-on .use-ic { color: #4f46e5; box-shadow: 0 1px 2px rgba(15,23,42,.08); }
    .use-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
    .use.is-on .use-body { grid-template-rows: 1fr; }
    .use-in { overflow: hidden; }
    .use-bar { position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: #0f172a; }
    .use.is-on .use-bar.run { animation: usebar var(--dur, 7s) linear forwards; }
    @keyframes usebar { from { width: 0 } to { width: 100% } }
    @media (prefers-reduced-motion: reduce) { .use-img, .use-body { transition: none; } .use.is-on .use-bar.run { animation: none; width: 100%; } }
  </style>
  <script>
    const root = document.querySelector('[data-uses]');
    if (root) {
      const items = [...root.querySelectorAll<HTMLElement>('.use')];
      const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = 0; let auto = !reduce; let t: ReturnType<typeof setTimeout> | undefined;
      const DUR = 7000;
      const show = (n: number) => {
        cur = (n + items.length) % items.length;
        items.forEach((el, k) => {
          el.classList.toggle('is-on', k === cur);
          el.querySelector('.use-head')?.setAttribute('aria-expanded', String(k === cur));
          const bar = el.querySelector('.use-bar'); bar?.classList.remove('run');
          if (k === cur && auto) { void (bar as HTMLElement)?.offsetWidth; bar?.classList.add('run'); }
        });
        shots.forEach((im, k) => im.classList.toggle('is-on', k === cur));
        clearTimeout(t);
        if (auto) t = setTimeout(() => show(cur + 1), DUR);
      };
      items.forEach((el, k) => el.querySelector('.use-head')?.addEventListener('click', () => { auto = false; show(k); }));
      // 화면에 보일 때만 자동으로 넘긴다
      const io = new IntersectionObserver(([e]) => { if (!e.isIntersecting) clearTimeout(t); else if (auto) show(cur); }, { threshold: 0.3 });
      io.observe(root);
      show(0);
    }
  </script>


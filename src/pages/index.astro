    <script>
      const jv = document.querySelector('[data-jv]');
      if (jv) {
        const segs = [...jv.querySelectorAll<SVGGElement>('.jv-seg')];
        const msgs = [...jv.querySelectorAll<HTMLElement>('.jv-msg')];
        const ask = jv.querySelector<HTMLElement>('.jv-ask-t'); const askBox = jv.querySelector<HTMLElement>('.jv-ask');
        const QS = ["보고서 먼저 봐 줬어?", "이번 주 누구 챙길까?", "오늘 결정할 거 있어?", "내가 놓친 거 없어?", "임원 보고 준비됐어?", "인수인계할 거 있어?"];
        let k = 0; let auto = !matchMedia('(prefers-reduced-motion: reduce)').matches; let t: ReturnType<typeof setInterval> | undefined; const still = !auto; let typer = 0; const box = jv.querySelector<HTMLElement>('.jv-ask-in');
        const show = (n: number) => { k = (n + segs.length) % segs.length; segs.forEach((g, i) => g.classList.toggle('is-on', i === k)); msgs.forEach((m, i) => m.classList.toggle('is-on', i === k)); if (ask && askBox) { clearInterval(typer); const q = QS[k]; if (still) { ask.textContent = q; } else { let c = 0; ask.textContent = ''; typer = window.setInterval(() => { ask.textContent = q.slice(0, ++c); if (box) box.scrollLeft = box.scrollWidth; if (c >= q.length) clearInterval(typer); }, 55); } } };
        const pick = (n: number) => { show(n); clearInterval(t); if (auto) t = setInterval(() => show(k + 1), 3200); };
        segs.forEach((g, i) => { g.addEventListener('click', () => pick(i)); g.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') pick(i); }); });
        msgs.forEach((m, i) => m.addEventListener('click', () => pick(i)));
        pick(0);
      }

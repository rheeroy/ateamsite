---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const list = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="팀장 아티클" description="1on1 · 피드백 · 목표 · 보고 · 의사결정 — 현장 컨설팅에서 나온 팀 운영 방법을 정리합니다.">
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-5 py-16">
      <p class="text-sm font-bold text-indigo-600">팀장 아티클</p>
      <h1 class="mt-3 text-3xl md:text-[42px] font-black tracking-tight leading-tight">오늘 바로 써먹는 팀 운영</h1>
      <p class="mt-4 text-lg text-slate-600">현장 컨설팅과 검증된 방법론에서 팀장에게 필요한 것만 골라 정리합니다.</p>
    </div>
  </section>
  <section class="max-w-4xl mx-auto px-5 py-12 divide-y divide-slate-200">
    {list.map((a) => (
      <a href={`/articles/${a.id}/`} class="group block py-8">
        <div class="text-xs font-bold text-indigo-600">{a.data.category} <span class="text-slate-400 font-medium ml-1">{fmt(a.data.date)}</span></div>
        <h2 class="mt-2 text-xl md:text-2xl font-bold leading-snug group-hover:text-indigo-700">{a.data.title}</h2>
        <p class="mt-2 text-slate-500 leading-relaxed">{a.data.description}</p>
      </a>
    ))}
  </section>
</Base>

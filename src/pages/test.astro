---
// 팀장 유형 테스트 (leada.team/test) — 15문항 · 8유형 · 유형별 함정(Derailer). 결과는 #t-코드 해시로 공유된다. 응답은 저장하지 않는다
import Base from '../layouts/Base.astro';
import { DEMO } from '../consts';
---
<Base title="나는 어떤 팀장일까? 팀장 유형 테스트" description="15개 상황 질문, 3분. 8가지 팀장 유형 중 나의 유형과 팀원이 보는 나, 빠지기 쉬운 함정까지 알려 드려요." ogImage="/og-test.png" bare>
<div id="tt" data-demo={DEMO}>
<div class="wrap">
  <header class="top">
    <a class="logo" href="/" aria-label="ATEAM 홈">
      <span class="mk" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"><path d="M4 20 L13 6"/><path d="M13 6 L20 6"/></svg></span>
      ATEAM
    </a>
  </header>

  <!-- INTRO -->
  <section id="intro">
    <span class="pill">팀장 유형 테스트 · 3분</span>
    <h1>나는 어떤 팀장일까?<br><span class="grad">8가지 팀장 유형</span></h1>
    <p class="lead">15개의 상황 질문에 솔직하게 답해 보세요.<br>나의 팀장 유형과 팀원이 보는 나, 그리고 빠지기 쉬운 함정까지 알려드려요.</p>
    <div style="margin-top:28px"><button class="btn btn-primary btn-block" id="startBtn" type="button">테스트 시작하기</button></div>
    <div class="meta"><span>질문 15개</span><span>·</span><span>약 3분</span><span>·</span><span>회원가입 없음</span></div>
    <p class="sect-title">이런 유형이 있어요</p>
    <div class="types" id="typeGrid"></div>
    <div class="foot">상황적 리더십 이론(지시 · 지지 행동)과 경쟁가치모형(안정 · 변화 지향) 등 리더십 연구, 그리고 조직 컨설팅 현장에서 본 리더 행동 패턴을 바탕으로 ATEAM이 만든 자기점검용 테스트예요. 우열을 가리는 평가가 아니라, 내 스타일을 돌아보는 출발점으로 봐 주세요.</div>
  </section>

  <!-- QUIZ -->
  <section id="quiz" class="hidden">
    <div class="qnum"><span id="qCount">1 / 15</span><span id="qAxis"></span></div>
    <div class="progress"><i id="qBar" style="width:0%"></i></div>
    <div class="qtext" id="qText"></div>
    <button class="opt" id="optA" type="button"><span class="k">A</span><span id="optAText"></span></button>
    <button class="opt" id="optB" type="button"><span class="k">B</span><span id="optBText"></span></button>
    <button class="back" id="backBtn" type="button">← 이전 질문</button>
  </section>

  <!-- RESULT -->
  <section id="result" class="hidden"></section>
</div>
<div class="toast" id="toast">링크를 복사했어요</div>
</div>
</Base>
<style is:global>
#tt{
  --bg:#0A0A18; --bg2:#14112B; --card:#17152E; --line:#2C2850;
  --text:#FFFFFF; --sub:#B9B6D3; --mute:#8C88AE;
  --p1:#7B7BFF; --p2:#C77DFF; --brand:#5B4BFF;
}
#tt *{box-sizing:border-box}
#tt{margin:0;padding:0}
#tt{
  
  color:var(--text);
  background:
    radial-gradient(900px 600px at 0% 0%, #3A1D6E 0%, transparent 60%),
    radial-gradient(800px 700px at 100% 60%, #241A6B 0%, transparent 60%),
    var(--bg);
  
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  letter-spacing:-0.2px;
}
#tt .wrap{max-width:640px;margin:0 auto;padding:28px 22px 64px}
#tt header.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:36px}
#tt .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;color:#fff;text-decoration:none}
#tt .logo .mk{width:34px;height:34px;border-radius:9px;background:var(--brand);display:flex;align-items:center;justify-content:center}
#tt .pill{display:inline-block;border:1px solid #4A4380;background:rgba(91,75,255,.12);color:#DCD9FF;border-radius:999px;padding:9px 18px;font-size:15px;font-weight:500}
#tt h1{font-size:44px;line-height:1.22;font-weight:900;margin:22px 0 0;letter-spacing:-1.5px}
#tt .grad{background:linear-gradient(90deg,var(--p1),var(--p2));-webkit-background-clip:text;background-clip:text;color:transparent}
#tt .lead{color:var(--sub);font-size:17px;line-height:1.65;margin:18px 0 0}
#tt .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 28px;border-radius:14px;border:none;font-family:inherit;font-size:17px;font-weight:700;cursor:pointer;text-decoration:none;transition:transform .15s, opacity .15s}
#tt .btn:active{transform:scale(.98)}
#tt .btn-primary{background:linear-gradient(90deg,#6B5BFF,#A66BFF);color:#fff;box-shadow:0 10px 30px rgba(107,91,255,.35)}
#tt .btn-ghost{background:transparent;color:#DCD9FF;border:1px solid #4A4380}
#tt .btn-block{width:100%}
#tt .meta{display:flex;gap:16px;color:var(--mute);font-size:14px;margin-top:14px}
#tt .types{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:16px}
#tt .tcard{background:rgba(23,21,46,.85);border:1px solid var(--line);border-radius:16px;padding:14px 8px 12px;text-align:center}
#tt .tcard svg{width:84px;height:84px;display:block;margin:0 auto 10px}
#tt .tcard .nm{font-size:13px;font-weight:700;line-height:1.3}
#tt .sect-title{font-size:15px;color:var(--mute);font-weight:600;margin:44px 0 0}
#tt .foot{color:var(--mute);font-size:12.5px;line-height:1.6;margin-top:48px;border-top:1px solid var(--line);padding-top:18px}
#tt .foot a{color:#B9B3FF}
#tt /* quiz */
.progress{height:6px;background:#221F42;border-radius:99px;overflow:hidden;margin:6px 0 10px}
#tt .progress>i{display:block;height:100%;background:linear-gradient(90deg,var(--p1),var(--p2));border-radius:99px;transition:width .3s}
#tt .qnum{color:var(--mute);font-size:14px;font-weight:600;display:flex;justify-content:space-between}
#tt .qtext{font-size:26px;font-weight:800;line-height:1.42;margin:30px 0 30px;letter-spacing:-.8px;min-height:110px}
#tt .opt{display:block;width:100%;text-align:left;background:var(--card);border:1.5px solid var(--line);color:#fff;border-radius:16px;padding:20px 20px;font-family:inherit;font-size:17px;line-height:1.55;font-weight:500;cursor:pointer;margin-bottom:12px;transition:border-color .15s, background .15s}
#tt .opt:hover{border-color:#6B5BFF;background:#1E1A3F}
#tt .opt .k{display:inline-block;width:26px;height:26px;border-radius:8px;background:#2A2654;color:#C9C3FF;font-size:13px;font-weight:800;text-align:center;line-height:26px;margin-right:10px}
#tt .back{background:none;border:none;color:var(--mute);font-family:inherit;font-size:15px;cursor:pointer;padding:12px 0;margin-top:6px}
#tt .back:disabled{opacity:.3;cursor:default}
#tt /* result */
.rhead{text-align:center;margin-top:8px}
#tt .rhead .eyebrow{color:var(--sub);font-size:15px;font-weight:600}
#tt .rhead svg{width:150px;height:150px;margin:22px auto 6px;display:block;filter:drop-shadow(0 16px 40px rgba(123,91,255,.45))}
#tt .rhead h2{font-size:38px;font-weight:900;margin:8px 0 0;letter-spacing:-1.2px}
#tt .rhead .en{color:var(--mute);font-size:14px;font-weight:600;letter-spacing:1px;margin-top:6px}
#tt .rhead .one{font-size:18px;line-height:1.6;color:#E6E3FF;margin:18px auto 0;max-width:460px}
#tt .box{background:rgba(23,21,46,.9);border:1px solid var(--line);border-radius:20px;padding:24px 22px;margin-top:16px}
#tt .box h3{margin:0 0 14px;font-size:17px;font-weight:800;display:flex;align-items:center;gap:8px}
#tt .box h3 .dot{width:8px;height:8px;border-radius:50%;background:var(--p2)}
#tt .box p{margin:0;color:#DAD7F2;font-size:16px;line-height:1.7}
#tt .box ul{list-style:disc;margin:0;padding-left:18px;color:#DAD7F2;font-size:16px;line-height:1.75}
#tt .bars{display:flex;flex-direction:column;gap:16px}
#tt .bar .lbl{display:flex;justify-content:space-between;font-size:14px;color:var(--sub);font-weight:600;margin-bottom:8px}
#tt .bar .lbl b{color:#fff}
#tt .bar .trk{height:10px;background:#221F42;border-radius:99px;position:relative;overflow:hidden}
#tt .bar .trk i{position:absolute;top:0;bottom:0;left:0;background:linear-gradient(90deg,var(--p1),var(--p2));border-radius:99px}
#tt .quote{font-size:17px;line-height:1.7;color:#fff;font-weight:600}
#tt .trap{border-color:#5A3A6E;background:linear-gradient(180deg,rgba(80,36,90,.35),rgba(23,21,46,.9))}
#tt .trap h3 .dot{background:#FF8A8A}
#tt .match{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#tt .match a{display:flex;align-items:center;gap:10px;background:#1C1939;border:1px solid var(--line);border-radius:14px;padding:12px;text-decoration:none;color:#fff}
#tt .match a svg{width:40px;height:40px;flex-shrink:0}
#tt .match small{display:block;color:var(--mute);font-size:12px;font-weight:600}
#tt .match b{font-size:14px}
#tt .cta{margin-top:22px;background:linear-gradient(135deg,#2A1E6B,#3B1F66);border:1px solid #5B4BFF;border-radius:22px;padding:26px 22px}
#tt .cta .t{font-size:20px;font-weight:800;line-height:1.45;margin:0}
#tt .cta p{color:#DCD9FF;font-size:15.5px;line-height:1.7;margin:12px 0 18px}
#tt .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
#tt .row .btn{flex:1 1 180px}
#tt .toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#fff;color:#14112B;font-weight:700;font-size:14px;padding:12px 18px;border-radius:12px;opacity:0;transition:opacity .2s;pointer-events:none}
#tt .toast.on{opacity:1}
#tt .allbox .tcard{cursor:pointer;text-decoration:none;color:#fff}
#tt .trapcard{margin-top:16px;border-radius:24px;padding:24px 20px 22px;background:linear-gradient(160deg,#3B1330 0%,#24112F 100%);border:1.5px solid #FF6B7A;box-shadow:0 0 0 6px rgba(255,107,122,.08),0 20px 50px rgba(255,80,110,.15)}
#tt .trapkicker{display:inline-flex;align-items:center;gap:8px;background:#FF6B7A;color:#1A0B14;font-weight:800;font-size:14px;border-radius:999px;padding:7px 14px 7px 10px}
#tt .trapname{font-size:30px;font-weight:900;margin-top:16px;letter-spacing:-1px;color:#FFD9DD}
#tt .trapen{font-size:12.5px;font-weight:700;letter-spacing:1.5px;color:#FF8E9A;margin-top:4px}
#tt .trapimg{margin:18px 0 0}
#tt .trapdesc{color:#F3DDE3;font-size:16px;line-height:1.7;margin:16px 0 0}
#tt .sigs{margin-top:18px;background:rgba(0,0,0,.22);border-radius:16px;padding:16px}
#tt .sigt{font-size:14px;font-weight:800;color:#FF9AA5;margin-bottom:10px}
#tt .sig{display:flex;gap:10px;align-items:flex-start;font-size:15px;line-height:1.55;color:#F3DDE3;padding:5px 0}
#tt .chk{width:18px;height:18px;border-radius:5px;border:2px solid #FF8E9A;flex-shrink:0;margin-top:2px}
#tt .hidden{display:none}
@media (max-width:480px){#tt h1{font-size:34px}
#tt .types{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
#tt .tcard svg{width:64px;height:64px}
#tt .tcard .nm{font-size:11.5px}
#tt .qtext{font-size:22px;min-height:96px}
#tt .rhead h2{font-size:32px}}

</style>
<script is:inline>

(function(){
  // ---------- 일러스트 (사람 캐릭터 · 함정 장면) ----------
  var INK = '#1F1A4D';
  var GRAD = {
    DCV:['#7B7BFF','#C77DFF'], DCS:['#5B8CFF','#7B7BFF'], DcV:['#FF7AB6','#A66BFF'], DcS:['#4F6BFF','#2BB3E0'],
    dCV:['#B36BFF','#FF8BD1'], dCS:['#FF9A76','#FF6FA8'], dcV:['#33C2B3','#5B8CFF'], dcS:['#8A7BFF','#5B4BFF']
  };
  // 사람 한 명: 머리 중심 (0,0), 머리 반지름 17, 몸통은 y 30~70
  function person(x, y, s, o){
    o = o || {};
    var skin = o.skin || '#F3C9A5', hair = o.hair || '#2B2140', shirt = o.shirt || '#FFFFFF';
    var g = '<g transform="translate('+x+','+y+') scale('+s+')">';
    if(o.hairStyle==='long') g += '<path d="M-21 2 C-23 -24 23 -24 21 2 L23 30 L-23 30 Z" fill="'+hair+'"/>';
    g += '<path d="M-34 70 C-34 42 -22 30 0 30 C22 30 34 42 34 70 Z" fill="'+shirt+'"/>';
    if(o.collar) g += '<path d="M-9 31 L0 44 L9 31" fill="none" stroke="'+o.collar+'" stroke-width="3" stroke-linejoin="round"/>';
    if(o.tie) g += '<path d="M0 34 L-4 40 L0 58 L4 40 Z" fill="'+o.tie+'"/>';
    g += '<rect x="-6" y="12" width="12" height="20" rx="5" fill="'+skin+'"/>';
    g += '<circle cx="0" cy="0" r="17" fill="'+skin+'"/>';
    var hs = o.hairStyle || 'short';
    if(hs==='short') g += '<path d="M-18 -1 C-20 -21 -6 -26 4 -24 C15 -23 21 -13 18 -1 C14 -10 5 -13 -5 -12 C-11 -11 -15 -7 -18 -1 Z" fill="'+hair+'"/>';
    if(hs==='side') g += '<path d="M-18 2 C-21 -20 -4 -27 8 -23 C17 -20 21 -11 18 0 C10 -8 -2 -10 -10 -6 C-14 -4 -16 -1 -18 2 Z" fill="'+hair+'"/>';
    if(hs==='long') g += '<path d="M-18 -2 C-18 -20 18 -20 18 -2 C10 -12 -2 -12 -12 -6 Z" fill="'+hair+'"/>';
    if(hs==='bun') g += '<circle cx="0" cy="-22" r="8" fill="'+hair+'"/><path d="M-18 -1 C-19 -19 19 -19 18 -1 C12 -10 -12 -10 -18 -1 Z" fill="'+hair+'"/>';
    if(hs==='curly') g += '<g fill="'+hair+'"><circle cx="-13" cy="-10" r="7"/><circle cx="-5" cy="-16" r="7"/><circle cx="5" cy="-16" r="7"/><circle cx="13" cy="-10" r="7"/><circle cx="-17" cy="-2" r="5"/><circle cx="17" cy="-2" r="5"/></g>';
    if(hs==='bald') g += '<path d="M-17 -3 C-17 -6 -15 -8 -13 -8 L-13 2 Z M17 -3 C17 -6 15 -8 13 -8 L13 2 Z" fill="'+hair+'"/>';
    var e = o.face || 'smile';
    if(e==='closed'){ g += '<path d="M-9 1 Q-6 -2 -3 1 M3 1 Q6 -2 9 1" stroke="'+INK+'" stroke-width="2" fill="none" stroke-linecap="round"/>'; }
    else { g += '<circle cx="-6" cy="1" r="2.2" fill="'+INK+'"/><circle cx="6" cy="1" r="2.2" fill="'+INK+'"/>'; }
    if(e==='smile'||e==='closed') g += '<path d="M-5 8 Q0 12.5 5 8" stroke="'+INK+'" stroke-width="2" fill="none" stroke-linecap="round"/>';
    if(e==='grin') g += '<path d="M-6 7 Q0 14 6 7 Z" fill="'+INK+'"/>';
    if(e==='flat') g += '<path d="M-4 9 L4 9" stroke="'+INK+'" stroke-width="2" stroke-linecap="round"/>';
    if(e==='worry') g += '<path d="M-4 10 Q0 7 4 10" stroke="'+INK+'" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M-9 -5 L-3 -3 M9 -5 L3 -3" stroke="'+INK+'" stroke-width="1.8" stroke-linecap="round"/>';
    if(e==='determined') g += '<path d="M-4 9 Q0 11 4 9" stroke="'+INK+'" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M-10 -5 L-3 -2 M10 -5 L3 -2" stroke="'+INK+'" stroke-width="2.2" stroke-linecap="round"/>';
    if(o.blush) g += '<circle cx="-10" cy="6" r="3" fill="#FF8FA3" opacity=".55"/><circle cx="10" cy="6" r="3" fill="#FF8FA3" opacity=".55"/>';
    if(o.glasses) g += '<g fill="none" stroke="'+INK+'" stroke-width="1.8"><circle cx="-6.5" cy="1" r="5"/><circle cx="6.5" cy="1" r="5"/><path d="M-1.5 1 L1.5 1"/></g>';
    if(o.sweat) g += '<path d="M20 -8 C20 -8 16 -2 16 1 C16 4 20 4 20 1 C20 -2 20 -8 20 -8 Z" fill="#8FD3FF"/>';
    if(o.back) g = '<g transform="translate('+x+','+y+') scale('+s+')"><path d="M-34 70 C-34 42 -22 30 0 30 C22 30 34 42 34 70 Z" fill="'+shirt+'"/><rect x="-6" y="12" width="12" height="20" rx="5" fill="'+skin+'"/><circle cx="0" cy="0" r="17" fill="'+hair+'"/>';
    return g + '</g>';
  }

  // 유형별 캐릭터 (200x200)
  var PORTRAIT = {
    DCV:function(){ return person(100,84,1.9,{hairStyle:'side',shirt:'#FFFFFF',tie:'#5B4BFF',face:'grin',hair:'#3A2A55'})+
      '<rect x="68" y="22" width="64" height="20" rx="6" fill="'+INK+'"/><path d="M60 42 Q100 54 140 42 L140 48 Q100 60 60 48 Z" fill="'+INK+'"/><path d="M100 26 L102.5 31 L108 31.5 L104 35 L105 40 L100 37.5 L95 40 L96 35 L92 31.5 L97.5 31 Z" fill="#FFD36B"/>'+
      '<path d="M158 196 L170 38" stroke="#fff" stroke-width="5" stroke-linecap="round"/><path d="M170 38 L198 50 L168 62 Z" fill="#FFD36B"/><circle cx="160" cy="168" r="11" fill="#F3C9A5"/>'; },
    DCS:function(){ return person(100,84,1.9,{hairStyle:'bun',shirt:'#EEF0FF',collar:'#5B8CFF',face:'smile',hair:'#4A3423',skin:'#F6D3B8'})+
      '<circle cx="150" cy="160" r="24" fill="#fff" stroke="'+INK+'" stroke-width="5"/><rect x="145" y="128" width="10" height="9" rx="2" fill="'+INK+'"/><path d="M150 160 L150 146 M150 160 L160 166" stroke="'+INK+'" stroke-width="4" stroke-linecap="round"/><circle cx="130" cy="176" r="11" fill="#F6D3B8"/>'; },
    DcV:function(){ return person(110,84,1.9,{hairStyle:'short',shirt:'#FFFFFF',face:'determined',hair:'#1E1630',skin:'#E8B48F'})+
      '<rect x="78" y="56" width="64" height="10" rx="5" fill="#FF4F7B"/><path d="M142 58 L160 50 L156 64 Z" fill="#FF4F7B"/>'+
      '<g stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".8"><path d="M14 92 L46 92"/><path d="M22 112 L50 112"/><path d="M10 132 L44 132"/></g>'+
      '<path d="M112 150 L100 172 L112 172 L104 194 L128 164 L115 164 L124 150 Z" fill="#FFD36B"/>'; },
    DcS:function(){ return person(96,84,1.9,{hairStyle:'side',shirt:'#FFFFFF',collar:'#2BB3E0',face:'flat',glasses:true,hair:'#1E1630'})+
      '<path d="M62 84 A34 34 0 0 1 130 84" fill="none" stroke="'+INK+'" stroke-width="6"/><rect x="56" y="78" width="12" height="20" rx="5" fill="'+INK+'"/><rect x="124" y="78" width="12" height="20" rx="5" fill="'+INK+'"/><path d="M62 96 Q66 112 84 110" fill="none" stroke="'+INK+'" stroke-width="4" stroke-linecap="round"/>'+
      '<rect x="134" y="122" width="52" height="68" rx="8" fill="#fff" stroke="'+INK+'" stroke-width="4"/><rect x="150" y="116" width="20" height="10" rx="3" fill="'+INK+'"/><g stroke="#2BB3E0" stroke-width="4" stroke-linecap="round" fill="none"><path d="M144 142 L149 147 L157 138"/><path d="M144 160 L149 165 L157 156"/><path d="M144 178 L149 183 L157 174"/></g><g stroke="#C9C6E0" stroke-width="4" stroke-linecap="round"><path d="M162 144 L178 144"/><path d="M162 162 L178 162"/><path d="M162 180 L178 180"/></g>'; },
    dCV:function(){ return person(96,92,1.8,{hairStyle:'long',shirt:'#FFFFFF',face:'grin',hair:'#5A2E1E',blush:true,skin:'#F6D3B8'})+
      '<g stroke="#FFE27A" stroke-width="4" stroke-linecap="round"><path d="M156 14 L156 4"/><path d="M180 26 L188 19"/><path d="M132 26 L124 19"/><path d="M188 48 L198 48"/></g>'+
      '<circle cx="156" cy="44" r="20" fill="#FFE27A"/><rect x="147" y="62" width="18" height="12" rx="3" fill="#fff"/><path d="M150 44 L156 52 L162 44" fill="none" stroke="#E0A800" stroke-width="3" stroke-linecap="round"/>'+
      '<circle cx="42" cy="168" r="11" fill="#F6D3B8"/><circle cx="150" cy="168" r="11" fill="#F6D3B8"/>'; },

    dCS:{trapName:"결정 보류형",trapEn:"DECISION DELAYER",signals:["\"조금만 더 지켜보죠\"를 자주 말한다", "같은 문제로 회의를 여러 번 한다", "어려운 피드백을 평가 시즌까지 미룬다"],
      name:'든든한 맏형형',en:'TRUSTED ANCHOR',one:'팀원들이 힘들 때 제일 먼저 찾는 사람. 이 팀장 밑에서는 마음 편히 일할 수 있어요.',
      traits:['팀원 이야기를 잘 들어 주고 공감한다','팀 분위기와 관계를 소중히 여긴다','갈등보다 화합을 먼저 생각한다'],
      seen:'"팀장님은 진짜 좋은 분이에요. 다만 가끔은 확실하게 정리해 주셨으면 해요."',
      trap:'좋은 관계를 지키려다 꼭 해야 할 피드백이나 결정을 미루게 될 수 있어요. "좋은 게 좋은 거"가 쌓이면 일 잘하는 팀원이 먼저 지쳐요.',
      try:'미뤄 둔 피드백 하나를 골라 이번 주 안에 구체적으로 전해 보세요. 사실 · 영향 · 기대 순서로요.',
      good:'DcV',hard:'DCV',
      ateam:'말하기 어려운 피드백일수록 근거가 필요해요. ATEAM은 쌓인 업무 기록을 바탕으로 피드백할 포인트를 정리해 줘요.'},
    dcV:{trapName:"독불장군형",trapEn:"LONE WOLF",signals:["팀원들이 내 일정과 관심사를 잘 모른다", "결정한 내용을 나중에야 공유한다", "회의보다 혼자 하는 게 편하다"],
      name:'독립 탐험가형',en:'INDEPENDENT EXPLORER',one:'늘 새로운 걸 찾아 나서는 아이디어 뱅크. 팀원에게 간섭하지 않고, 본인도 간섭받지 않는 걸 좋아해요.',
      traits:['새로운 트렌드와 방식에 누구보다 빠르다','팀원에게 자유를 주고 간섭하지 않는다','혼자서도 성과를 만들어 내는 힘이 있다'],
      seen:'"팀장님은 늘 뭔가 새로운 걸 하고 계세요. 우리 팀이랑은 어떻게 연결되는지 궁금해요."',
      trap:'혼자 앞서가다 보면 팀과의 소통과 공유가 줄어들기 쉬워요. 팀원들은 자유롭다고 느끼기보다 방치됐다고 느낄 수 있어요.',
      try:'요즘 내가 관심 있는 것 하나를 팀 회의에서 10분만 공유하고, 팀원 의견을 들어 보세요.',
      good:'DCS',hard:'DcS',
      ateam:'자유롭게 맡기는 팀장일수록 팀 상황이 안 보여요. ATEAM은 따로 묻지 않아도 팀의 흐름을 한 화면에 모아 줘요.'},
    dcS:{trapName:"나홀로 해결사형",trapEn:"LONE FIXER",signals:["\"그냥 내가 할게요\"를 하루에 몇 번씩 한다", "팀에서 야근하는 사람이 늘 나다", "휴가 중에도 업무 연락을 받는다"],
      name:'묵묵한 실무 에이스형',en:'WORKING ACE',one:'팀에서 일을 제일 잘하는 사람이 바로 팀장. 말보다 실력으로 보여 주고, 급한 불은 직접 꺼요.',
      traits:['실무 역량이 뛰어나 팀원들의 롤모델이 된다','말보다 행동으로 솔선수범한다','급한 일은 본인이 직접 해결한다'],
      seen:'"팀장님이 제일 바쁘세요. 도와드리고 싶은데 뭘 해야 할지 모르겠어요."',
      trap:'"내가 하는 게 빠르지"가 반복되면 팀장은 점점 바빠지고, 팀원은 성장할 기회를 잃어요. 팀장이 실무에 묶이면 팀 전체를 볼 시간이 사라져요.',
      try:'이번 주 내가 직접 하려던 일 하나를 팀원에게 맡기고, 결과보다 과정을 함께 돌아봐 주세요.',
      good:'DCV',hard:'dCV',
      ateam:'실무에 묶인 팀장에게 가장 필요한 건 팀을 볼 시간이에요. ATEAM은 팀장이 놓친 성과 · 팀원 신호를 대신 모아 짚어 줘요.'}
  };

  // axis: D 목표 드라이브, C 사람 케어, V 변화 지향 / A = 높은 쪽
  var Q = [
    {a:'D',q:'분기 첫 주, 팀 목표를 세울 때 나는',A:'숫자부터 박는다. 목표는 구체적일수록 팀이 움직인다.',B:'큰 방향만 잡고, 세부 목표는 팀원들과 같이 정한다.'},
    {a:'C',q:'팀원 표정이 며칠째 어둡다.',A:'따로 커피 한잔 하자고 먼저 말을 건다.',B:'업무에 지장이 없다면, 개인 사정은 존중해서 지켜본다.'},
    {a:'V',q:'회사에서 새로운 협업 툴을 도입한다고 한다.',A:'우리 팀이 먼저 써 보겠다고 손든다.',B:'다른 팀이 써 보는 걸 보고 판단한다.'},
    {a:'D',q:'마감 3일 전인데 진행률이 60%다.',A:'바로 일정을 다시 쪼개고, 매일 체크인을 잡는다.',B:'다들 알아서 하고 있을 테니 하루 더 지켜본다.'},
    {a:'C',q:'팀원이 정말 잘한 일이 있다.',A:'그날 바로, 무엇이 좋았는지 구체적으로 칭찬한다.',B:'평가 시즌에 확실히 반영해 주면 된다고 생각한다.'},
    {a:'V',q:'지금 잘 돌아가는 업무 프로세스가 있다.',A:'잘 돌아가도 더 나은 방법이 없는지 계속 손본다.',B:'잘 돌아가는 건 건드리지 않는 게 원칙이다.'},
    {a:'D',q:'회의가 30분째 결론 없이 맴돈다.',A:'"그럼 이렇게 갑시다" 하고 내가 정리한다.',B:'충분히 의견이 나올 때까지 조금 더 기다린다.'},
    {a:'C',q:'1on1을 하면 나는 주로',A:'요즘 어떤지, 커리어 고민부터 묻는다.',B:'업무 진행 상황 위주로 효율적으로 끝낸다.'},
    {a:'V',q:'팀원이 다소 엉뚱한 아이디어를 냈다.',A:'작게라도 해 보자고 시간을 떼어 준다.',B:'지금 하는 일부터 안정시키고 나중에 보자고 한다.'},
    {a:'D',q:'팀원에게 새 업무를 맡길 때 나는',A:'기한 · 기준 · 결과물 형태까지 정해서 준다.',B:'목적만 설명하고, 방법은 맡긴다.'},
    {a:'C',q:'팀원이 실수로 일을 크게 그르쳤다.',A:'수습부터 같이 하고, 사람을 다그치지는 않는다.',B:'원인과 책임을 분명히 짚고 넘어간다.'},
    {a:'V',q:'내가 생각하는 좋은 팀은',A:'매년 일하는 방식이 조금씩 진화하는 팀',B:'누가 와도 같은 품질이 나오는 팀'},
    {a:'D',q:'팀 성과가 목표에 못 미치고 있다.',A:'원인을 쪼개 보고 바로 다음 액션을 정한다.',B:'팀원들이 스스로 해법을 찾도록 판을 열어 준다.'},
    {a:'C',q:'팀 분위기에 대해 나는',A:'분위기는 팀장이 적극적으로 챙겨야 한다고 생각한다.',B:'일이 잘 되면 분위기는 자연스럽게 따라온다고 생각한다.'},
    {a:'V',q:'연말 팀 회고를 시작할 때 나는',A:'"내년엔 뭘 바꿔 볼까?"부터 묻는다.',B:'"올해 잘 된 걸 어떻게 지킬까?"부터 묻는다.'}
  ];
  var AXIS_LABEL = {D:'목표 · 과업', C:'사람 · 관계', V:'변화 · 혁신'};

  var answers = [], cur = 0;
  var $ = function(id){return document.getElementById(id);};
  var DEMO_URL = (document.getElementById('tt').getAttribute('data-demo')) || 'https://leada.team/demo';

  // type grid
  var order = ['DCV','DCS','DcV','DcS','dCV','dCS','dcV','dcS'];
  $('typeGrid').innerHTML = order.map(function(c){
    return '<div class="tcard">'+badge(c,56)+'<div class="nm">'+TYPES[c].name+'</div></div>';
  }).join('');

  function show(id){
    ['intro','quiz','result'].forEach(function(s){ $(s).classList.toggle('hidden', s!==id); });
    var top=document.getElementById('tt').getBoundingClientRect().top+window.scrollY; window.scrollTo(0, top>0?top:0);
  }

  function renderQ(){
    var q = Q[cur];
    $('qCount').textContent = (cur+1)+' / '+Q.length;
    $('qAxis').textContent = '';
    $('qBar').style.width = (cur/Q.length*100)+'%';
    $('qText').textContent = q.q;
    $('optAText').textContent = q.A;
    $('optBText').textContent = q.B;
    $('backBtn').disabled = cur===0;
    
  }
  function pick(v){
    answers[cur] = v;
    if(cur < Q.length-1){ cur++; renderQ(); }
    else { finish(); }
  }
  function scores(){
    var s = {D:0,C:0,V:0};
    Q.forEach(function(q,i){ if(answers[i]==='A') s[q.a]++; });
    return s;
  }
  function codeFrom(s){
    return (s.D>=3?'D':'d')+(s.C>=3?'C':'c')+(s.V>=3?'V':'S');
  }
  function finish(){
    var s = scores();
    var code = codeFrom(s);
    var pct = {D:Math.round(s.D/5*100), C:Math.round(s.C/5*100), V:Math.round(s.V/5*100)};
    try{ location.hash = 't-'+code+'-'+s.D+s.C+s.V; }catch(e){}
    renderResult(code, pct, true);
  }

  function renderResult(code, pct, mine){
    var t = TYPES[code];
    var bars = pct ? ('<div class="box"><h3><span class="dot"></span>나의 리더십 성향</h3><div class="bars">'+
      ['D','C','V'].map(function(k){
        var lo = {D:'자율에 맡김',C:'일 중심',V:'안정 운영'}[k];
        var hi = {D:'목표 드라이브',C:'사람 케어',V:'변화 추구'}[k];
        return '<div class="bar"><div class="lbl"><span>'+lo+'</span><b>'+AXIS_LABEL[k]+' '+pct[k]+'%</b><span>'+hi+'</span></div><div class="trk"><i style="width:'+Math.max(pct[k],4)+'%"></i></div></div>';
      }).join('')+'</div></div>') : '';
    var html =
      '<div class="rhead">'+
        '<div class="eyebrow">'+(mine?'나의 팀장 유형은':'이 팀장 유형은')+'</div>'+
        badge(code,150)+
        '<h2 class="grad">'+t.name+'</h2>'+
        '<div class="en">'+t.en+'</div>'+
        '<p class="one">'+t.one+'</p>'+
      '</div>'+
      bars+
      '<div class="box"><h3><span class="dot"></span>이런 강점이 있어요</h3><ul>'+t.traits.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul></div>'+
      '<div class="box"><h3><span class="dot"></span>팀원이 보는 나</h3><p class="quote">'+t.seen+'</p></div>'+
      '<div class="trapcard"><div class="trapkicker"><span class="warn" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#1A0B14" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 L22 20 L2 20 Z"/><path d="M12 10 L12 14"/><path d="M12 17 L12 17.5"/></svg></span>빠지기 쉬운 함정</div>'+'<div class="trapname">'+t.trapName+'</div><div class="trapen">'+t.trapEn+'</div>'+'<div class="trapimg">'+trapArt(code)+'</div>'+'<p class="trapdesc">'+t.trap+'</p>'+'<div class="sigs"><div class="sigt">이런 모습이 보이면 주의</div>'+t.signals.map(function(x){return '<div class="sig"><span class="chk"></span>'+x+'</div>';}).join('')+'</div></div>'+
      '<div class="box"><h3><span class="dot"></span>이번 주 딱 하나만 해 본다면</h3><p>'+t.try+'</p></div>'+
      '<div class="box"><h3><span class="dot"></span>궁합</h3><div class="match">'+
        '<a href="#t-'+t.good+'">'+badge(t.good,40)+'<span><small>찰떡 파트너</small><b>'+TYPES[t.good].name+'</b></span></a>'+
        '<a href="#t-'+t.hard+'">'+badge(t.hard,40)+'<span><small>서로 노력이 필요한</small><b>'+TYPES[t.hard].name+'</b></span></a>'+
      '</div></div>'+
      '<div class="cta"><p class="t">팀 운영의 모든 걸<br>혼자 감당하기 벅차지 않으세요?</p>'+
        '<p>'+t.ateam+'</p>'+
        '<a class="btn btn-primary btn-block" href="'+DEMO_URL+'">ATEAM 데모 신청하기</a></div>'+
      '<div class="row">'+
        '<button class="btn btn-ghost" id="shareBtn" type="button">결과 링크 복사</button>'+
        '<button class="btn btn-ghost" id="retryBtn" type="button">'+(mine?'다시 하기':'나도 테스트하기')+'</button>'+
      '</div>'+
      '<div class="box allbox" style="margin-top:28px"><h3><span class="dot"></span>8가지 팀장 유형 모두 보기</h3><div class="types" style="margin-top:0">'+
        order.map(function(c){return '<a class="tcard" href="#t-'+c+'">'+badge(c,48)+'<div class="nm">'+TYPES[c].name+'</div></a>';}).join('')+
      '</div></div>'+
      '<div class="foot">이 테스트는 자기점검용이에요. 같은 팀장도 팀 상황과 팀원에 따라 다른 모습을 보이니, 결과는 "지금의 나"를 돌아보는 출발점으로 활용해 주세요.</div>';
    $('result').innerHTML = html;
    show('result');
    $('shareBtn').onclick = function(){
      var url = location.href;
      var done = function(){ var el=$('toast'); el.classList.add('on'); setTimeout(function(){el.classList.remove('on');},1600); };
      try{
        navigator.clipboard.writeText(url).then(done, function(){ $('toast').textContent='주소창의 링크를 복사해 주세요'; done(); });
      }catch(e){ $('toast').textContent='주소창의 링크를 복사해 주세요'; done(); }
    };
    $('retryBtn').onclick = start;
  }

  function start(){
    answers = []; cur = 0;
    try{ history.replaceState(null,'',location.pathname); }catch(e){ try{location.hash='';}catch(_){} }
    show('quiz'); renderQ();
  }

  function route(){
    var h = (location.hash||'').replace('#','');
    var m = h.match(/^t-([Dd][Cc][VS])(?:-([0-5])([0-5])([0-5]))?$/);
    if(m && TYPES[m[1]]){
      var pct = m[2]!=null ? {D:+m[2]*20, C:+m[3]*20, V:+m[4]*20} : null;
      var mine = answers.length===Q.length && codeFrom(scores())===m[1];
      renderResult(m[1], pct, mine);
    }
  }

  $('startBtn').onclick = start;
  $('optA').onclick = function(){ pick('A'); };
  $('optB').onclick = function(){ pick('B'); };
  $('backBtn').onclick = function(){ if(cur>0){ cur--; renderQ(); } };
  window.addEventListener('hashchange', route);
  route();
})();

</script>

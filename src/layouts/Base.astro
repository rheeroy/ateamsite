---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { BIZ, DEMO, LOGIN, SIGNUP } from '../consts';
interface Props { title?: string; description?: string; dark?: boolean; article?: boolean }
const { title, description = '성과관리 · 팀원관리 · 의사결정을 한 단계 끌어올리는 팀운영 슈퍼에이전트. 팀장 1명 구독, 팀원은 무료 초대, 14일 무료 체험.', dark = false, article = false } = Astro.props;
const full = title ? `${title} | ATEAM` : 'ATEAM — 팀 자율주행 엔진이 S급 팀장을 만들어줍니다';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0B0F1E" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content="ATEAM" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary" />
</head>
<body class="bg-white text-slate-900">
  <header class={`sticky top-0 z-40 backdrop-blur ${dark ? 'bg-ink/95 text-white border-b border-white/10' : 'bg-white/85 border-b border-slate-200'}`}>
    <div class="max-w-6xl mx-auto px-5 h-16 flex items-center gap-6">
      <a href="/" aria-label="ATEAM 홈"><Logo /></a>
      <nav class={`hidden md:flex items-center gap-6 text-[14.5px] ${dark ? 'text-slate-300' : 'text-slate-600'}`}>
        <a href="/#features" class="hover:opacity-80">기능</a>
        <a href="/#members" class="hover:opacity-80">팀원</a>
        <a href="/pricing" class="hover:opacity-80">요금</a>
        <a href="/articles/" class="hover:opacity-80">아티클</a>
        <a href={DEMO} class="hover:opacity-80">데모 신청</a>
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <a href={LOGIN} class={`hidden sm:inline-flex text-sm font-semibold px-3 py-2 rounded-lg ${dark ? 'text-slate-200 hover:bg-white/10' : 'text-slate-700 hover:bg-slate-100'}`}>로그인</a>
        <a href={SIGNUP} class="inline-flex text-sm font-bold px-4 py-2.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-500">무료 체험</a>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="bg-ink text-slate-400">
    <div class="max-w-6xl mx-auto px-5 py-12 grid gap-8 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="space-y-3">
        <Logo cls="text-white" />
        <p class="text-sm leading-relaxed">성과관리 · 팀원관리 · 의사결정을 한 단계 끌어올리는<br />팀운영 슈퍼에이전트</p>
      </div>
      <div class="text-sm space-y-2"><b class="block text-slate-200 mb-3">서비스</b>
        <a href="/#features" class="block hover:text-white">기능</a><a href="/pricing" class="block hover:text-white">요금 안내</a><a href={SIGNUP} class="block hover:text-white">14일 무료 체험</a><a href={DEMO} class="block hover:text-white">데모 신청</a><a href={LOGIN} class="block hover:text-white">로그인</a></div>
      <div class="text-sm space-y-2"><b class="block text-slate-200 mb-3">자료 · 정책</b>
        <a href="/articles/" class="block hover:text-white">팀장 아티클</a><a href="/terms" class="block hover:text-white">이용약관</a><a href="/privacy" class="block hover:text-white font-semibold text-slate-300">개인정보처리방침</a><a href="/refund" class="block hover:text-white">환불정책</a></div>
    </div>
    <div class="border-t border-white/10">
      <div class="max-w-6xl mx-auto px-5 py-5 text-xs text-slate-500 leading-relaxed space-y-1">
        <p class="flex flex-wrap gap-x-3 gap-y-1"><span>상호 {BIZ.name}</span><span>대표 {BIZ.ceo}</span><span>사업자등록번호 {BIZ.regNo}</span><span>통신판매업 신고번호 {BIZ.mailOrderNo}</span></p>
        <p class="flex flex-wrap gap-x-3 gap-y-1"><span>주소 {BIZ.address}</span><span>전화 {BIZ.phone}</span><span>고객문의 {BIZ.email}</span></p>
        <p>© 2026 {BIZ.name}. ATEAM</p>
      </div>
    </div>
  </footer>
</body>
</html>
